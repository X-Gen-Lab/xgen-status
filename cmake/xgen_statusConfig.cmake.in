@PACKAGE_INIT@

set(xgen_status_VERSION "@PROJECT_VERSION@")
set(_xgs_available "@XGS_COMPONENTS@")
set(_xgs_requested "${xgen_status_FIND_COMPONENTS}")
if(NOT _xgs_requested)
    set(_xgs_requested status)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/xgenStatusCompatibility.cmake")

foreach(_xgs_component IN LISTS _xgs_requested)
    set(xgen_status_${_xgs_component}_FOUND FALSE)
    if(NOT _xgs_component IN_LIST _xgs_available)
        set(xgen_status_NOT_FOUND_MESSAGE
            "xgen-status component '${_xgs_component}' is not installed; available: ${_xgs_available}")
        continue()
    endif()
    set(_xgs_dependencies status)
    if(_xgs_component STREQUAL "strings")
        list(APPEND _xgs_dependencies strings)
    endif()
    foreach(_xgs_dependency IN LISTS _xgs_dependencies)
        if(NOT TARGET xgs::${_xgs_dependency})
            include("${CMAKE_CURRENT_LIST_DIR}/xgenStatus-${_xgs_dependency}-targets.cmake")
        endif()
        set(_xgs_type INTERFACE_LIBRARY)
        if(_xgs_dependency STREQUAL "strings")
            set(_xgs_type STATIC_LIBRARY)
        endif()
        xgs_check_target(xgs::${_xgs_dependency} "${_xgs_type}" "@PROJECT_VERSION@" _xgs_error)
        if(_xgs_error)
            set(xgen_status_NOT_FOUND_MESSAGE "${_xgs_error}")
            set(xgen_status_FOUND FALSE)
            return()
        endif()
    endforeach()
    set(xgen_status_${_xgs_component}_FOUND TRUE)
endforeach()
check_required_components(xgen_status)

unset(_xgs_available)
unset(_xgs_requested)
unset(_xgs_component)
unset(_xgs_dependencies)
unset(_xgs_dependency)
unset(_xgs_type)
unset(_xgs_error)
